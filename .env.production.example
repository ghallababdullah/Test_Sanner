# Docker Hub
DOCKERHUB_NAMESPACE=your_dockerhub_username

# Public ports on the server
FRONTEND_PORT=80
BACKEND_PORT=8080
RABBITMQ_MANAGEMENT_PORT=15672
WATCHTOWER_POLL_INTERVAL=60

# PostgreSQL
POSTGRES_DB=scanner_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_database_password

# RabbitMQ
RABBIT_USER=scanner
RABBIT_PASS=change_me_to_a_strong_rabbitmq_password

# Backend security
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JPA_SHOW_SQL=false

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=ghallabdev@gmail.com
MAIL_PASSWORD=replace_with_new_gmail_app_password
APP_MAIL_FROM=ghallabdev@gmail.com
APP_MAIL_NAME=СканПроверка
APP_SUPPORT_EMAIL=ghallabdev@gmail.com
APP_PARTNERSHIP_EMAIL=ghallabdev@gmail.com
APP_SITE_COMPANY_NAME=Галлаб Абдулла

# Public URLs
FRONTEND_BASE_URL=https://your-domain.example
BACKEND_PUBLIC_BASE_URL=https://your-domain.example

# Browser security
APP_ALLOWED_ORIGINS=https://your-domain.example
APP_AUTH_COOKIE_SAME_SITE=Lax
APP_AUTH_COOKIE_FORCE_SECURE=true
APP_AUTH_COOKIE_DOMAIN=

# OCR and messaging
SCAN_EXCHANGE=scan.exchange
SCAN_REQUEST_ROUTING_KEY=scan.ocr.requested
SCAN_REQUEST_QUEUE=scan.ocr.request.queue
SCAN_RESULT_ROUTING_KEY=scan.ocr.completed
SCAN_RESULT_QUEUE=scan.ocr.result.queue
OCR_PROCESSING_TIMEOUT=1800
