  "item": [
    {
      "name": "TEST 1: Start Scanning Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"testId\": \"{{test_id}}\",\n  \"name\": \"Сеанс сканирования класс 10A\",\n  \"description\": \"Сканирование контрольной работы по математике\",\n  \"deviceId\": \"iphone-teacher-001\",\n  \"deviceModel\": \"iPhone 14 Pro Max\",\n  \"metadata\": {\n    \"ocrLibrary\": \"TensorFlow\",\n    \"ocrVersion\": \"2.1.0\",\n    \"appVersion\": \"1.0.0\",\n    \"phoneOS\": \"iOS 16.2\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/scan/start-session",
          "host": ["{{base_url}}"],
          "path": ["api", "scan", "start-session"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has correct structure\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.equal(true);",
              "    pm.expect(jsonData.data.id).to.exist;",
              "});",
              "",
              "// Save session ID for next tests",
              "var jsonData = pm.response.json();",
              "pm.globals.set(\"session_id\", jsonData.data.id);"
            ]
          }
        }
      ]
    },
