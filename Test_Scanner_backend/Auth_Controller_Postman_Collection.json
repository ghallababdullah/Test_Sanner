{
  "info": {
    "name": "Auth Controller Tests",
    "description": "Полные тест-кейсы для Auth Controller в Postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "email",
      "value": "john.doe@test.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "SecurePassword123",
      "type": "string"
    },
    {
      "key": "firstName",
      "value": "John",
      "type": "string"
    },
    {
      "key": "lastName",
      "value": "Doe",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. REGISTER",
      "item": [
        {
          "name": "Register - Valid User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has success = true\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Response has correct message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include(\"registered successfully\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\",\n  \"middleName\": \"Michael\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"phoneNumber\": \"+1-234-567-8900\"\n}}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Register - Email Already Exists",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\",\n  \"email\": \"{{email}}\",\n  \"password\": \"Password123\"\n}}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. LOGIN",
      "item": [
        {
          "name": "Login - Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has tokens\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.accessToken).to.exist;",
                  "    pm.expect(jsonData.data.refreshToken).to.exist;",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"accessToken\", jsonData.data.accessToken);",
                  "pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login - Wrong Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{\n  \"email\": \"{{email}}\",\n  \"password\": \"WrongPassword123\"\n}}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. REFRESH TOKEN",
      "item": [
        {
          "name": "Refresh Token - Valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"accessToken\", jsonData.data.accessToken);",
                  "pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/refresh-token?refreshToken={{refreshToken}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh-token"
              ],
              "query": [
                {
                  "key": "refreshToken",
                  "value": "{{refreshToken}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. VERIFY EMAIL",
      "item": [
        {
          "name": "Verify Email - Valid Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/verify-email?token=PASTE_EMAIL_VERIFICATION_TOKEN_HERE",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-email"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "PASTE_EMAIL_VERIFICATION_TOKEN_HERE"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. FORGET PASSWORD",
      "item": [
        {
          "name": "Forget Password - Valid Email",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/forget-password?email={{email}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "forget-password"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{email}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. RESET PASSWORD",
      "item": [
        {
          "name": "Reset Password - Valid Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{\n  \"newPassword\": \"NewSecurePassword456\",\n  \"confirmPassword\": \"NewSecurePassword456\"\n}}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/reset-password?token=PASTE_RESET_TOKEN_HERE",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "reset-password"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "PASTE_RESET_TOKEN_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Reset Password - Passwords Don't Match",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{\n  \"newPassword\": \"NewPassword123\",\n  \"confirmPassword\": \"DifferentPassword456\"\n}}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/reset-password?token=PASTE_RESET_TOKEN_HERE",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "reset-password"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "PASTE_RESET_TOKEN_HERE"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}

