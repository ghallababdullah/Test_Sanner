            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Математика 5 класс - Контрольная работа\",\n  \"subject\": \"Математика\",\n  \"description\": \"Контрольная работа по пройденному материалу\",\n  \"totalQuestions\": 10,\n  \"maxScore\": 100.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tests/create-test",
              "host": ["{{baseUrl}}"],
              "path": ["tests", "create-test"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"✅ Status 201 Created\", function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "pm.test(\"✅ Success true\", function () {",
                  "    pm.expect(pm.response.json().success).to.equal(true);",
                  "});",
                  "pm.test(\"✅ Save test1Id\", function () {",
                  "    pm.environment.set(\"test1Id\", pm.response.json().data.id);",
                  "    pm.environment.set(\"userId\", pm.response.json().data.creatorId);",
                  "});"
                ]
              }
            }
