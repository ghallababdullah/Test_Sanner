# Copy this file to .env and fill in your values.
# All values below are the defaults used when variables are not set.

# ── Database ────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/scanner_db
DB_USER=postgres
DB_PASSWORD=051020

# ── RabbitMQ ─────────────────────────────────────────────────
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=scanner
RABBIT_PASS=scanner_pass

# ── JWT ───────────────────────────────────────────────────────
# Must be at least 32 chars, keep this secret in production.
JWT_SECRET=abdullah4u12345abdullah4u12345abdullah4u12345

# ── Mail (Mailtrap dev / real SMTP prod) ─────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_user
MAIL_PASSWORD=your_mailtrap_pass

# Scan storage
SCAN_STORAGE_ROOT=./storage/scans

# Scan messaging
SCAN_EXCHANGE=scan.exchange
SCAN_REQUEST_ROUTING_KEY=scan.ocr.requested
SCAN_REQUEST_QUEUE=scan.ocr.request.queue
